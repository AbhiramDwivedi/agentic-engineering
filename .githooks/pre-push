#!/usr/bin/env sh
# Pre-push validation gate. Runs the SAME checks CI runs (deploy.yml's build job
# + test.yml), so a red build never leaves the machine. Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass only in a true emergency with `git push --no-verify` (don't make a habit of it).

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
fail=0

echo "[pre-push] prose_lint (docs, --hard-only) ..."
python meta/prose_lint.py $(find docs -name '*.md') --hard-only || fail=1

echo "[pre-push] pytest (companion code + doc-sync, CI-parity install) ..."
# Mirror CI exactly (test.yml: pip install -e ".[dev]" -c constraints.txt, then
# pytest) inside a throwaway venv holding ONLY the declared dependencies. The
# ambient dev venv carries extras (e.g. pydantic pulled in transitively by
# langgraph) that mask an undeclared dependency, so plain `python -m pytest`
# here would pass while CI fails. Running against the isolated install is what
# makes that divergence impossible. That covers UNDECLARED deps; it does not
# by itself cover DRIFTING ones: pyproject.toml declares compatibility ranges,
# not exact versions, and without a constraints file this venv and CI would
# each resolve fresh from PyPI on their own schedule, so an upstream release
# still inside the declared range could turn CI red on a branch that never
# touched dependencies, with zero local signal. constraints.txt pins the exact
# verified build and closes that gap. The venv is reused; it only reinstalls
# when pyproject.toml OR constraints.txt changes, so a new unlisted import
# still fails here (undeclared dep) and a bumped pin still forces a rebuild
# (drifted dep).
(
  cd listing-studio || exit 1
  CIVENV=".civenv"
  MARK="$CIVENV/.deps.hash"
  pick_py() { if [ -x "$CIVENV/bin/python" ]; then echo "$CIVENV/bin/python"; else echo "$CIVENV/Scripts/python.exe"; fi; }
  cur="$(git hash-object pyproject.toml constraints.txt)"
  if [ ! -e "$(pick_py)" ] || [ "$(cat "$MARK" 2>/dev/null)" != "$cur" ]; then
    echo "[pre-push]   (building CI-parity venv from pyproject.toml + constraints.txt ...)"
    rm -rf "$CIVENV"
    python -m venv "$CIVENV" || exit 1
    "$(pick_py)" -m pip install -q -e ".[dev]" -c constraints.txt || exit 1
    echo "$cur" > "$MARK"
  fi
  "$(pick_py)" -m pytest -q || exit 1
) || fail=1

if python -c "import mkdocs" 2>/dev/null; then
  echo "[pre-push] mkdocs build --strict ..."
  python -m mkdocs build --strict --quiet || fail=1
else
  echo "[pre-push] NOTE: mkdocs not installed locally; CI still runs 'mkdocs build --strict'."
  echo "[pre-push]       install it with 'pip install -r requirements.txt' for a full local gate."
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "[pre-push] BLOCKED: a validation failed above. Fix it before pushing." >&2
  echo "[pre-push] (emergency override: git push --no-verify)" >&2
  exit 1
fi

echo "[pre-push] all local validations passed."
exit 0
